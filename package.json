{
  "name": "nihongo-michi",
  "productName": "Nihongo Michi",
  "version": "1.0.0",
  "description": "Nihongo Michi - learn real-world Japanese from zero to JLPT N1 (Windows desktop app)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/RickUsingGitHub/nihongo-michi.git"
  },
  "main": "main.js",
  "private": true,
  "scripts": {
